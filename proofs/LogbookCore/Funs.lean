def slug.is_slug_char (c : Std.U8) : Result Bool := do
  if c >= 97#u8
  then
    if c <= 122#u8
    then ok true
    else if c >= 48#u8
         then ok (c <= 57#u8)
         else ok false
  else if c >= 48#u8
       then ok (c <= 57#u8)
       else ok false

