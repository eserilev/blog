    Source: 'crates/logbook-core/src/post.rs', lines 78:0-83:1
    Visibility: public -/
def post.reading_minutes (words : Std.U32) : Result Std.U32 := do
  let full ← words / post.WORDS_PER_MINUTE
  let rest ← words % post.WORDS_PER_MINUTE
  let minutes ← if rest = 0#u32
                  then ok full
                  else full + 1#u32
  if minutes = 0#u32
  then ok 1#u32
  else ok minutes

