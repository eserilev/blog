# The text of the PROD_ENV secret. The deploy writes it to /srv/logbook/prod.env.
# Never commit real values: this repo is public.

# The public origin. Its host is the passkey RP ID: changing it later breaks every passkey.
LOGBOOK_ORIGIN=https://unclebill.blog

# The bucket: database replica (db/) and images (uploads/).
# Hetzner needs virtual-host style, so S3_FORCE_PATH_STYLE stays false.
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BUCKET=logbook
S3_REGION=fsn1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# Pinged after each nightly backup check (healthchecks.io). Empty: no ping.
HEALTHCHECK_URL=

# The NWS API needs contact info in the User-Agent.
NWS_USER_AGENT=logbook (https://github.com/eserilev/blog)
